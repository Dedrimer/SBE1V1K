From: Dedrimer <13420015738@sina.cn>
Date: Sat, 15 Aug 2026 17:10:00 +0800
Subject: [PATCH] net: ethernet: qualcomm: ppe: fix RPS and IRQ distribution

The RPS sysctl stores the requested core bitmap, but the hash mapping path
always rebuilds its CPU mask from EDMA_RX_DEFAULT_BITMAP.  As a result,
writing rps_bitmap_cores reports the new value without changing the hardware
queue mapping.

The queue mapping also expects each EDMA ring interrupt to run on its matching
CPU.  No affinity is configured when the interrupts are registered, so the
GIC routes every RX and TX completion interrupt to CPU0 by default.

Build the hash CPU mask from the configured bitmap and distribute RX and TX
completion ring interrupts across the four hardware cores.  Affinity setup is
kept non-fatal so failure to steer an interrupt does not prevent networking
from starting.

Signed-off-by: Dedrimer <13420015738@sina.cn>
---
 drivers/net/ethernet/qualcomm/ppe/edma.c        | 18 ++++++++++++++++++
 drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c |  5 ++++-
 2 files changed, 22 insertions(+), 1 deletion(-)

--- a/drivers/net/ethernet/qualcomm/ppe/edma.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma.c
@@ -7,6 +7,7 @@
   */
 
 #include <linux/clk.h>
+#include <linux/cpumask.h>
 #include <linux/delay.h>
 #include <linux/kernel.h>
 #include <linux/module.h>
@@ -385,6 +386,17 @@ static irqreturn_t edma_misc_handle_irq(
 	return IRQ_HANDLED;
 }
 
+static void edma_irq_set_affinity(unsigned int irq, u32 ring_id)
+{
+	u32 cpu = ring_id % EDMA_MAX_CORE;
+	int ret;
+
+	ret = irq_set_affinity(irq, cpumask_of(cpu));
+	if (ret)
+		pr_warn("Failed to set IRQ %u affinity to CPU%u: %d\n",
+			irq, cpu, ret);
+}
+
 static int edma_irq_register(void)
 {
 	struct edma_hw_info *hw_info = edma_ctx->hw_info;
@@ -423,6 +435,9 @@ static int edma_irq_register(void)
 			goto txcmpl_ring_intr_req_fail;
 		}
 
+		edma_irq_set_affinity(edma_ctx->intr_info.intr_txcmpl[i],
+				      txcmpl->ring_start + i);
+
 		pr_debug("TXCMPL ring: %d IRQ:%d request success: %s\n",
 			 txcmpl->ring_start + i,
 			 edma_ctx->intr_info.intr_txcmpl[i],
@@ -460,6 +475,9 @@ static int edma_irq_register(void)
 			goto rx_desc_ring_intr_req_fail;
 		}
 
+		edma_irq_set_affinity(edma_ctx->intr_info.intr_rx[i],
+				      rx->ring_start + i);
+
 		pr_debug("RXDESC ring: %d IRQ:%d request success: %s\n",
 			 rx->ring_start + i,
 			 edma_ctx->intr_info.intr_rx[i],
--- a/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
+++ b/drivers/net/ethernet/qualcomm/ppe/edma_cfg_rx.c
@@ -993,12 +993,15 @@ void edma_cfg_rx_napi_add(void)
  */
 int edma_cfg_rx_rps_hash_map(void)
 {
-	cpumask_t edma_rps_cpumask = {{EDMA_RX_DEFAULT_BITMAP}};
+	cpumask_t edma_rps_cpumask;
 	int map_len = 0, idx = 0, ret = 0;
 	u32 q_off = EDMA_RX_QUEUE_START;
 	u32 q_map[EDMA_MAX_CORE] = {0};
 	u32 hash, cpu;
 
+	cpumask_clear(&edma_rps_cpumask);
+	cpumask_bits(&edma_rps_cpumask)[0] = edma_cfg_rx_rps_bitmap_cores;
+
 	/* Map all possible hash values to queues used by the EDMA Rx
 	 * rings based on a bitmask, which represents the cores to be mapped.
 	 * These queues are expected to be mapped to different Rx rings
-- 
2.51.0
