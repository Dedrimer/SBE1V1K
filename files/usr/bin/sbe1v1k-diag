#!/bin/sh

echo '=== release ==='
cat /etc/sbe1v1k-release 2>/dev/null
cat /etc/openwrt_release 2>/dev/null

echo '=== board ==='
ubus call system board 2>/dev/null

echo '=== kernel ==='
uname -a
cat /proc/cmdline

echo '=== partitions ==='
cat /proc/partitions
blkid 2>/dev/null

echo '=== network ==='
ip -br link
ip -br addr
ubus call network.interface dump 2>/dev/null

echo '=== wireless ==='
iw dev 2>/dev/null
iw phy 2>/dev/null

echo '=== modules ==='
lsmod

echo '=== recent kernel warnings/errors ==='
dmesg | grep -Ei 'error|fail|warn|ath12k|qcom_ppe|rtl826|qca80|mmc|f2fs' | tail -n 400

echo '=== recent system log ==='
logread | tail -n 400
