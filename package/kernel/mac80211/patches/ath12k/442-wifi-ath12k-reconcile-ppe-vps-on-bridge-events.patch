From: Yanghan Ye <yyh94306@gmail.com>
Subject: [PATCH] wifi: ath12k: reconcile PPE VPs on bridge events

PPE direct-switch VPs cannot be used by VAPs that are Linux bridge ports.
The attach-time check is insufficient because netif upper changes can happen
after peers have already been routed. Observe NETDEV_CHANGEUPPER and tear
down the affected VP (including AP_VLAN child VPs) when a VAP enters a bridge;
re-attach it when the VAP leaves the bridge.

Keep VP/profile teardown in the existing detach path so the PPE core releases
all host peer mappings, and remove the old peer-route entry guard which used
the parent VP before AP_VLAN routing selected its child VP.

Signed-off-by: Yanghan Ye <yyh94306@gmail.com>
---
 drivers/net/wireless/ath/ath12k/dp.h  |  3 +++
 drivers/net/wireless/ath/ath12k/ppe.c | 67 +++++++++++++++++++++++++++
 2 files changed, 70 insertions(+)

diff --git a/drivers/net/wireless/ath/ath12k/dp.h b/drivers/net/wireless/ath/ath12k/dp.h
index 9d96758..f4c8c9a 100644
--- a/drivers/net/wireless/ath/ath12k/dp.h
+++ b/drivers/net/wireless/ath/ath12k/dp.h
@@ -7,5 +7,6 @@
 #include <linux/dma-direction.h>
 #include <linux/dmapool.h>
 #include <linux/list.h>
+#include <linux/notifier.h>
 #include <linux/skbuff.h>
 #include <linux/types.h>
@@ -305,6 +306,8 @@ struct ath12k_ppe_ds {
 	bool registered;
 	bool started;
 	bool quiesced;
+	struct notifier_block netdev_nb;
+	bool netdev_notifier_registered;
 	struct ath12k_ppe_ds_stats stats;
 };
 #endif
diff --git a/drivers/net/wireless/ath/ath12k/ppe.c b/drivers/net/wireless/ath/ath12k/ppe.c
index 0d0a640..5e6d2a1 100644
--- a/drivers/net/wireless/ath/ath12k/ppe.c
+++ b/drivers/net/wireless/ath/ath12k/ppe.c
@@ -384,6 +384,67 @@ void ath12k_ppe_ds_vlan_remove(struct ath12k_vif *vlan)
 	vlan->ppe_vlan_route_programmed = false;
 }
 
+static int ath12k_ppe_ds_netdev_event(struct notifier_block *nb,
+					       unsigned long event, void *ptr)
+{
+	struct ath12k_ppe_ds *ppe = container_of(nb, struct ath12k_ppe_ds,
+						 netdev_nb);
+	struct net_device *dev = netdev_notifier_info_to_dev(ptr);
+	struct wireless_dev *wdev;
+	struct ieee80211_vif *vif;
+	struct ath12k_vif *ahvif;
+	struct ath12k_link_vif *arvif;
+	struct ath12k_base *ab;
+	struct netdev_notifier_changeupper_info *info;
+
+	if (event != NETDEV_CHANGEUPPER || !dev)
+		return NOTIFY_DONE;
+
+	wdev = dev->ieee80211_ptr;
+	if (!wdev)
+		return NOTIFY_DONE;
+
+	vif = wdev_to_ieee80211_vif(wdev);
+	if (!vif)
+		return NOTIFY_DONE;
+
+	ahvif = ath12k_vif_to_ahvif(vif);
+	if (!ahvif)
+		return NOTIFY_DONE;
+
+	/* AP_VLAN has no firmware link VIF; resolve it through its parent. */
+	if (vif->type == NL80211_IFTYPE_AP_VLAN) {
+		if (!ahvif->ppe_parent)
+			return NOTIFY_DONE;
+		arvif = &ahvif->ppe_parent->deflink;
+	} else {
+		arvif = &ahvif->deflink;
+	}
+
+	if (!arvif->ar)
+		return NOTIFY_DONE;
+	ab = arvif->ar->ab;
+	if (&ab->dp.ppe_ds != ppe)
+		return NOTIFY_DONE;
+
+	info = ptr;
+	if (!info->upper_dev || !netif_is_bridge_master(info->upper_dev))
+		return NOTIFY_DONE;
+
+	if (info->linking) {
+		if (vif->type == NL80211_IFTYPE_AP_VLAN)
+			ath12k_ppe_ds_vlan_detach(ahvif, arvif);
+		else
+			ath12k_ppe_ds_vif_detach(arvif);
+	} else if (vif->type == NL80211_IFTYPE_AP_VLAN) {
+		ath12k_ppe_ds_vlan_attach(ahvif, arvif);
+	} else {
+		ath12k_ppe_ds_vif_attach(arvif);
+	}
+
+	return NOTIFY_OK;
+}
+
 int ath12k_ppe_ds_vif_attach(struct ath12k_link_vif *arvif)
 {
 	struct ath12k_base *ab = arvif->ar->ab;
@@ -1020,5 +1060,10 @@ int ath12k_ppe_ds_attach(struct ath12k_base *ab)
 	ppe->registered = true;
 	ppe->quiesced = true;
+	ppe->netdev_nb.notifier_call = ath12k_ppe_ds_netdev_event;
+	if (!register_netdevice_notifier(&ppe->netdev_nb))
+		ppe->netdev_notifier_registered = true;
+	else
+		ath12k_warn(ab, "failed to register PPE bridge notifier\n");
 	ath12k_info(ab, "PPE direct-switch node %d registered\n",
 		    qcom_ppe_ds_node_id(ppe->node));
 	return 0;
@@ -1068,6 +1109,11 @@ void ath12k_ppe_ds_detach(struct ath12k_base *ab)
 	if (!ppe->registered)
 		return;
 
+	if (ppe->netdev_notifier_registered) {
+		unregister_netdevice_notifier(&ppe->netdev_nb);
+		ppe->netdev_notifier_registered = false;
+	}
+
 	ath12k_ppe_ds_stop(ab);
 	qcom_ppe_ds_node_free(ppe->node);
 	ppe->node = NULL;
@@ -1427,27 +1470,10 @@ void ath12k_ppe_ds_peer_route(struct ath12k *ar,
 	struct ath12k_vif *vlan = arsta->ahsta->ppe_vlan;
 	bool track_peer = !sta->mlo || arsta->is_assoc_link;
 	int ret, vp = arvif->ppe_vp;
 	u32 map = 0;
 
-	struct wireless_dev *wdev = ieee80211_vif_to_wdev(vif);
-
 	if (!ppe->started || arvif->ppe_vp < 64)
 		return;
 
-	/* A VAP may join its software bridge after the PPE VP was
-	 * allocated.  Do not leave an authorized peer on the direct
-	 * RxOLE path, which cannot flood the bridge's L2 broadcasts.
-	 */
-	if (enable && wdev && wdev->netdev &&
-	    netif_is_bridge_port(wdev->netdev)) {
-		ath12k_wmi_config_peer_ppeds_routing(ar, arsta->addr,
-						     arvif->vdev_id,
-						     arvif->ppe_vp, false);
-		if (vif->type == NL80211_IFTYPE_STATION)
-			ath12k_hif_write32(ab, ATH12K_PPE_SEARCH_TABLE_BASE +
-				   arvif->ppe_search_idx * 4, 0);
-		return;
-	}
-
 	if (vlan && vif->type == NL80211_IFTYPE_AP &&
 	    vlan->ppe_parent == arvif->ahvif) {
