#!/bin/sh
# Apply an SBE1V1K network-mode request prepared by the LuCI controller.

. /lib/functions.sh

CONF=sbe1v1k_netmode
BACKUP_DIR=/etc/sbe1v1k-netmode-backup
STATE_DIR=/tmp/sbe1v1k-netmode
PENDING=$STATE_DIR/pending
WATCHDOG_PID=$STATE_DIR/watchdog.pid
RESULT=$STATE_DIR/result
LOCK_DIR=$STATE_DIR/lock
RESTORE_SCRIPT=/usr/sbin/sbe1v1k-netmode-restore
LOG=/tmp/sbe1v1k-netmode-apply.log
LAN_PORTS="eth0 eth1 eth2"
WAN_PORT=eth3
UPLINK=sbe1v1k_wwan
RELAY=sbe1v1k_relay
REQUEST_ID=${1:-}

LOCK_HELD=0
BACKUP_READY=0
LIVE_TOUCHED=0
STARTED=0

mkdir -p "$STATE_DIR"

log() { printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

valid_id() {
	[ -n "$1" ] && case "$1" in *[!0-9a-fA-F-]*) return 1;; esac
}

pending_field() {
	sed -n "s/^$1=//p" "$PENDING" 2>/dev/null | head -n 1
}

write_result() {
	local status="$1" message="$2" tmp="$RESULT.tmp.$$"
	message=$(printf '%s' "$message" | tr '\r\n' '  ')
	{
		printf 'request_id=%s\n' "$REQUEST_ID"
		printf 'status=%s\n' "$status"
		printf 'updated=%s\n' "$(date +%s)"
		printf 'message=%s\n' "$message"
	} > "$tmp" && mv -f "$tmp" "$RESULT"
}

write_pending() {
	local phase="$1" started="$2" tmp="$PENDING.tmp.$$"
	{
		printf 'request_id=%s\n' "$REQUEST_ID"
		printf 'mode=%s\n' "$MODE"
		printf 'timeout=%s\n' "$TIMEOUT"
		printf 'started=%s\n' "$started"
		printf 'phase=%s\n' "$phase"
	} > "$tmp" && mv -f "$tmp" "$PENDING"
}

release_lock() {
	if [ "$LOCK_HELD" = 1 ]; then
		rmdir "$LOCK_DIR" 2>/dev/null
		LOCK_HELD=0
	fi
}

acquire_lock() {
	local waited=0
	while ! mkdir "$LOCK_DIR" 2>/dev/null; do
		waited=$((waited + 1))
		[ "$waited" -lt 30 ] || {
			log "ERROR: timed out waiting for operation lock"
			return 1
		}
		sleep 1
	done
	LOCK_HELD=1
	trap release_lock 0
	trap 'release_lock; exit 1' HUP INT TERM
}

kill_watchdog() {
	local pid
	[ -f "$WATCHDOG_PID" ] || return 0
	pid=$(cat "$WATCHDOG_PID" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) ;; *) [ "$pid" = "$$" ] || kill "$pid" 2>/dev/null ;; esac
	rm -f "$WATCHDOG_PID"
}

restart_services() {
	local rc=0
	/etc/init.d/network restart >> "$LOG" 2>&1 || rc=1
	/etc/init.d/dnsmasq restart >> "$LOG" 2>&1 || rc=1
	/etc/init.d/odhcpd restart >> "$LOG" 2>&1 || rc=1
	/etc/init.d/relayd restart >> "$LOG" 2>&1 || rc=1
	/etc/init.d/firewall reload >> "$LOG" 2>&1 || rc=1
	return "$rc"
}

restore_snapshot() {
	local f rc=0
	[ "$BACKUP_READY" = 1 ] || return 0

	for f in network wireless dhcp firewall; do
		if [ -f "$BACKUP_DIR/$f" ]; then
			cp -a "$BACKUP_DIR/$f" "/etc/config/$f" || rc=1
		else
			rc=1
		fi
	done

	uci -q revert network
	uci -q revert wireless
	uci -q revert dhcp
	uci -q revert firewall

	if [ "$LIVE_TOUCHED" = 1 ]; then
		log "restarting services after failed apply"
		restart_services || rc=1
	fi

	return "$rc"
}

fail() {
	local message="$*" current
	log "ERROR: $message"
	kill_watchdog
	if restore_snapshot; then
		rm -rf "$BACKUP_DIR"
	else
		log "ERROR: snapshot restore was incomplete"
	fi
	current=$(pending_field request_id)
	[ "$current" = "$REQUEST_ID" ] && rm -f "$PENDING"
	write_result error "$message"
	exit 1
}

uci_get() { uci -q get "$1" 2>/dev/null; }

valid_ipv4() {
	printf '%s\n' "$1" | awk -F. '
		BEGIN { valid = 1 }
		NF != 4 { valid = 0; next }
		{ for (i = 1; i <= 4; i++) if ($i !~ /^[0-9]+$/ || $i > 255) valid = 0 }
		END { exit valid ? 0 : 1 }
	' >/dev/null 2>&1
}

valid_key() {
	local len=${#KEY}
	case "$ENC" in
		none|owe) KEY="" ;;
		psk2)
			if [ "$len" = 64 ]; then
				case "$KEY" in *[!0-9a-fA-F]*) return 1;; esac
			else
				[ "$len" -ge 8 ] && [ "$len" -le 63 ] || return 1
			fi
			;;
		sae|sae-mixed) [ "$len" -ge 8 ] && [ "$len" -le 63 ] || return 1 ;;
		*) return 1 ;;
	esac
}

valid_bssid() {
	printf '%s\n' "$1" | grep -Eq '^([0-9a-fA-F]{2}:){5}[0-9a-fA-F]{2}$'
}

device_has_name() {
	local name
	config_get name "$1" name
	[ "$name" = "$2" ] && FOUND_DEV=1
}

ensure_brlan() {
	local p section
	FOUND_DEV=0
	config_load network
	config_foreach device_has_name device br-lan
	[ "$FOUND_DEV" = 1 ] && return 0

	section=$(uci -q add network device) || return 1
	uci -q set "network.$section.name=br-lan" || return 1
	uci -q set "network.$section.type=bridge" || return 1
	for p in $LAN_PORTS; do
		uci -q add_list "network.$section.ports=$p" || return 1
	done
	log "created bridge device br-lan ($LAN_PORTS)"
}

ensure_wan() {
	[ -n "$(uci_get network.wan)" ] && return 0
	uci -q set network.wan=interface || return 1
	uci -q set "network.wan.device=$WAN_PORT" || return 1
	uci -q set network.wan.proto=dhcp || return 1
	log "created wan interface"
}

set_lan_static() {
	local ip="$1" prefix="$2" gw="$3" dns="$4"
	ensure_brlan || return 1
	uci -q set network.lan=interface || return 1
	uci -q set network.lan.device=br-lan || return 1
	uci -q set network.lan.proto=static || return 1
	uci -q delete network.lan.ipaddr
	uci -q add_list "network.lan.ipaddr=$ip/$prefix" || return 1
	uci -q delete network.lan.netmask
	uci -q delete network.lan.gateway
	uci -q delete network.lan.dns
	uci -q delete network.lan.ip6gw
	uci -q set network.lan.ip6assign=60 || return 1

	if [ -n "$gw" ]; then
		uci -q set "network.lan.gateway=$gw" || return 1
		[ -z "$dns" ] || uci -q add_list "network.lan.dns=$dns" || return 1
	fi
}

remove_repeater_networks() {
	local legacy_network legacy_device
	uci -q delete "network.$UPLINK"
	uci -q delete "network.$RELAY"

	# Migrate sections created by the first plugin release without touching
	# unrelated user-defined wwan/relay interfaces.
	legacy_network=$(uci_get network.relay.network)
	legacy_device=$(uci_get network.wwan.device)
	if [ "$legacy_network" = "lan wwan" ] && [ "$legacy_device" = wwan0 ]; then
		uci -q delete network.wwan
		uci -q delete network.relay
	fi
}

firewall_find_lan_zone() {
	local name
	config_get name "$1" name
	[ "$name" = lan ] && LAN_ZONE="$1"
}

firewall_repeater_membership() {
	local action="$1"
	LAN_ZONE=""
	config_load firewall
	config_foreach firewall_find_lan_zone zone
	[ -n "$LAN_ZONE" ] || return 1

	uci -q del_list "firewall.$LAN_ZONE.network=$UPLINK"
	uci -q del_list "firewall.$LAN_ZONE.network=$RELAY"
	if [ "$action" = add ]; then
		uci -q add_list "firewall.$LAN_ZONE.network=$UPLINK" || return 1
		uci -q add_list "firewall.$LAN_ZONE.network=$RELAY" || return 1
	fi
}

wifi_owned_sta_remove() {
	local sec="$1" mode network ifname
	config_get mode "$sec" mode
	config_get network "$sec" network
	config_get ifname "$sec" ifname

	if [ "$sec" = sbe1v1k_sta ] ||
	   { [ "$mode" = sta ] && [ "$network" = wwan ] && [ "$ifname" = wwan0 ]; }; then
		uci -q delete "wireless.$sec"
	fi
}

remove_owned_sta() {
	config_load wireless
	config_foreach wifi_owned_sta_remove wifi-iface
}

wifi_radio_band() {
	local sec="$1" want="$2" band
	[ -n "$RADIO" ] && return 0
	config_get band "$sec" band
	[ "$band" = "$want" ] && RADIO="$sec"
}

wifi_find_radio() {
	local want="$1"
	RADIO=""
	config_load wireless
	config_foreach wifi_radio_band wifi-device "$want"
	[ -n "$RADIO" ] && printf '%s\n' "$RADIO"
}

setup_sta() {
	uci -q set wireless.sbe1v1k_sta=wifi-iface || return 1
	uci -q set "wireless.sbe1v1k_sta.device=$RADIO" || return 1
	uci -q set wireless.sbe1v1k_sta.mode=sta || return 1
	uci -q set "wireless.sbe1v1k_sta.network=$UPLINK" || return 1
	uci -q set "wireless.sbe1v1k_sta.ssid=$SSID" || return 1
	uci -q delete wireless.sbe1v1k_sta.bssid
	[ -z "$BSSID" ] || uci -q set "wireless.sbe1v1k_sta.bssid=$BSSID" || return 1
	uci -q set wireless.sbe1v1k_sta.disabled=0 || return 1
	uci -q set "wireless.sbe1v1k_sta.encryption=$ENC" || return 1
	uci -q delete wireless.sbe1v1k_sta.ifname
	uci -q delete wireless.sbe1v1k_sta.key
	[ -z "$KEY" ] || uci -q set "wireless.sbe1v1k_sta.key=$KEY" || return 1
	log "configured plugin-owned STA on $RADIO (encryption=$ENC)"
}

ensure_lan_dhcp() {
	if [ -z "$(uci_get dhcp.lan)" ]; then
		uci -q set dhcp.lan=dhcp || return 1
		uci -q set dhcp.lan.interface=lan || return 1
		uci -q set dhcp.lan.start=100 || return 1
		uci -q set dhcp.lan.limit=150 || return 1
		uci -q set dhcp.lan.leasetime=12h || return 1
	fi
}

lan_dhcp_enable() {
	ensure_lan_dhcp || return 1
	uci -q delete dhcp.lan.ignore
	uci -q set dhcp.lan.dhcpv4=server || return 1
	uci -q set dhcp.lan.dhcpv6=server || return 1
	uci -q set dhcp.lan.ra=server || return 1
}

lan_dhcp_disable() {
	ensure_lan_dhcp || return 1
	uci -q set dhcp.lan.ignore=1 || return 1
	uci -q set dhcp.lan.dhcpv4=disabled || return 1
	uci -q set dhcp.lan.dhcpv6=disabled || return 1
	uci -q set dhcp.lan.ra=disabled || return 1
}

apply_router() {
	ensure_wan || return 1
	set_lan_static "$LAN_IP" "$LAN_PREFIX" "" "" || return 1
	uci -q delete network.wan.disabled
	remove_repeater_networks
	firewall_repeater_membership remove || return 1
	remove_owned_sta
	lan_dhcp_enable
}

apply_bypass() {
	ensure_wan || return 1
	set_lan_static "$LAN_IP" "$LAN_PREFIX" "$GATEWAY" "${DNS:-$GATEWAY}" || return 1
	uci -q set network.wan.disabled=1 || return 1
	remove_repeater_networks
	firewall_repeater_membership remove || return 1
	remove_owned_sta
	lan_dhcp_disable
}

apply_repeater() {
	ensure_wan || return 1
	set_lan_static "$LAN_IP" "$LAN_PREFIX" "" "" || return 1
	uci -q set network.wan.disabled=1 || return 1
	uci -q set "network.$UPLINK=interface" || return 1
	uci -q set "network.$UPLINK.proto=dhcp" || return 1
	uci -q delete "network.$UPLINK.device"
	uci -q set "network.$RELAY=interface" || return 1
	uci -q set "network.$RELAY.proto=relay" || return 1
	uci -q set "network.$RELAY.network=lan $UPLINK" || return 1
	uci -q set "network.$RELAY.ipaddr=$LAN_IP" || return 1
	uci -q set "network.$RELAY.forward_dhcp=1" || return 1
	uci -q set "network.$RELAY.forward_bcast=1" || return 1
	firewall_repeater_membership add || return 1
	remove_owned_sta
	setup_sta || return 1
	lan_dhcp_disable
}

validate_request() {
	valid_ipv4 "$LAN_IP" || return 1
	case "$LAN_PREFIX" in ''|*[!0-9]*) return 1;; esac
	[ "$LAN_PREFIX" -ge 8 ] && [ "$LAN_PREFIX" -le 30 ] || return 1
	case "$TIMEOUT" in ''|*[!0-9]*) return 1;; esac
	[ "$TIMEOUT" -ge 30 ] && [ "$TIMEOUT" -le 600 ] || return 1

	case "$MODE" in
		router) ;;
		bypass)
			valid_ipv4 "$GATEWAY" || return 1
			[ -z "$DNS" ] || valid_ipv4 "$DNS" || return 1
			;;
		repeater)
			[ -n "$SSID" ] && [ "${#SSID}" -le 32 ] || return 1
			[ -z "$BSSID" ] || valid_bssid "$BSSID" || return 1
			case "$BAND" in 2g|5g|6g) ;; *) return 1;; esac
			valid_key || return 1
			if [ "$BAND" = 6g ]; then
				case "$ENC" in sae|owe) ;; *) return 1;; esac
			fi
			RADIO=$(wifi_find_radio "$BAND")
			[ -n "$RADIO" ] || return 1
			;;
		*) return 1 ;;
	esac
}

take_snapshot() {
	local f tmp="$BACKUP_DIR.new.$$"
	rm -rf "$tmp"
	mkdir -m 700 "$tmp" || return 1
	for f in network wireless dhcp firewall; do
		[ -f "/etc/config/$f" ] || { rm -rf "$tmp"; return 1; }
		cp -a "/etc/config/$f" "$tmp/$f" || { rm -rf "$tmp"; return 1; }
	done
	rm -rf "$BACKUP_DIR"
	mv "$tmp" "$BACKUP_DIR" || return 1
	BACKUP_READY=1
}

main() {
	local current
	valid_id "$REQUEST_ID" || { log "ERROR: invalid or missing request id"; exit 1; }
	current=$(pending_field request_id)
	[ "$current" = "$REQUEST_ID" ] || { log "ERROR: stale request $REQUEST_ID"; exit 1; }
	acquire_lock || {
		current=$(pending_field request_id)
		[ "$current" = "$REQUEST_ID" ] && rm -f "$PENDING"
		write_result error "timed out waiting for another operation"
		exit 1
	}
	current=$(pending_field request_id)
	[ "$current" = "$REQUEST_ID" ] || { log "request=$REQUEST_ID was cancelled or superseded"; exit 0; }

	config_load "$CONF"
	config_get MODE settings mode
	config_get LAN_IP settings lan_ip
	config_get LAN_PREFIX settings lan_prefix 24
	config_get GATEWAY settings gateway
	config_get DNS settings dns
	config_get SSID settings ssid
	config_get BSSID settings bssid
	config_get KEY settings key
	config_get ENC settings encryption
	config_get BAND settings band
	config_get TIMEOUT settings timeout 180

	validate_request || fail "request validation failed"
	write_pending applying 0 || fail "unable to update operation state"
	take_snapshot || fail "unable to create a complete configuration snapshot"
	log "snapshot saved for request=$REQUEST_ID"

	case "$MODE" in
		router) apply_router || fail "unable to prepare router mode" ;;
		bypass) apply_bypass || fail "unable to prepare bypass mode" ;;
		repeater) apply_repeater || fail "unable to prepare repeater mode" ;;
	esac

	STARTED=$(date +%s)
	write_pending applying "$STARTED" || fail "unable to arm operation state"
	( sleep "$TIMEOUT"; "$RESTORE_SCRIPT" "$REQUEST_ID" watchdog ) &
	echo $! > "$WATCHDOG_PID" || fail "unable to record watchdog pid"
	log "watchdog armed (${TIMEOUT}s), request=$REQUEST_ID mode=$MODE"

	uci -q commit network || fail "unable to commit network configuration"
	uci -q commit wireless || fail "unable to commit wireless configuration"
	uci -q commit dhcp || fail "unable to commit DHCP configuration"
	uci -q commit firewall || fail "unable to commit firewall configuration"

	LIVE_TOUCHED=1
	restart_services || fail "one or more network services failed to restart"
	write_pending applied "$STARTED" || fail "unable to mark configuration as applied"
	write_result applied "configuration applied; confirmation required"
	log "request=$REQUEST_ID mode=$MODE applied"
}

main "$@"
