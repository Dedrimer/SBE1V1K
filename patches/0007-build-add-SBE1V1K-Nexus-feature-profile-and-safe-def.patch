new file mode 100755
index 0000000000..7609f2db69
--- /dev/null
+++ b/files/etc/uci-defaults/99-sbe1v1k-nexus
@@ -0,0 +1,14 @@
+#!/bin/sh
+
+# Keep first boot predictable: use the requested UI, but do not let optional
+# proxy/DNS applications take over routing before the owner configures them.
+if uci -q get luci.main >/dev/null; then
+	uci -q set luci.main.mediaurlbase='/luci-static/argon'
+	uci -q commit luci
+fi
+
+for service in passwall openclash adguardhome; do
+	[ -x "/etc/init.d/$service" ] && "/etc/init.d/$service" disable
+done
+
+exit 0
