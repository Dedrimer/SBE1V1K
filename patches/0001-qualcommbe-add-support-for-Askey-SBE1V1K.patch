+/ {
+	model = "Askey SBE1V1K";
+	compatible = "askey,sbe1v1k", "qcom,ipq9574";
+
+	aliases {
+		led-boot = &led_blue;
+		led-failsafe = &led_red;
+		led-running = &led_blue;
+		led-upgrade = &led_blue;
+
