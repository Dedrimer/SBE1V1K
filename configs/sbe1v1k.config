CONFIG_HAVE_DOT_CONFIG=y
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq95xx=y
CONFIG_TARGET_qualcommbe_ipq95xx_DEVICE_askey_sbe1v1k=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_BINARY_FOLDER="$(TOPDIR)/out"
CONFIG_USE_APK=y
CONFIG_PACKAGE_luci-ssl=y

CONFIG_LUCI_LANG_zh_Hans=y

# LuCI software center and daily administration
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-acme=y
CONFIG_PACKAGE_luci-theme-argon=y

# Containers, downloads and local storage services
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-app-aria2=y
CONFIG_PACKAGE_luci-app-samba4=y

# Network services, monitoring and optimization
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_luci-app-smartdns=y
CONFIG_PACKAGE_luci-app-adblock-fast=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# eMMC storage management
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_parted=y

# The SBE1V1K has no exposed USB controller or USB port
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3 is not set
# CONFIG_PACKAGE_kmod-usb-dwc3-qcom is not set

# Command-line tools useful for maintenance
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_nano-full=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_tcpdump-mini=y
